{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "toolbox",
	"compatibility_date": "2026-10-03",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [{ "pattern": "toolbox.5seg.top", "custom_domain": true }],
	"workers_dev": true,
	"preview_urls": true
}
